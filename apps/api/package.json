{
  "name": "@narada/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "tsx src/index.ts",
    "lint": "eslint .",
    "format": "prettier . --write --ignore-path ../../.prettierignore",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@narada/auth": "workspace:*",
    "@narada/db": "workspace:*",
    "@narada/env": "workspace:*",
    "@narada/otp": "workspace:*",
    "@narada/storage": "workspace:*",
    "better-auth": "1.6.22",
    "cors": "^2.8.6",
    "country-state-city": "^3.2.1",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "geo-tz": "^8.1.9",
    "helmet": "^8.1.0",
    "music-metadata": "^11.15.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.2",
    "@types/node": "^20.19.40",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "pg": "^8.21.0",
    "pino-pretty": "^13.1.3",
    "prettier": "3.8.3",
    "supertest": "^7.2.2",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^4.1.7"
  }
}
