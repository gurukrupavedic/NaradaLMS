{
  "name": "@narada/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "format": "prettier . --write --ignore-path ../../.prettierignore",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@narada/auth": "workspace:*",
    "@narada/db": "workspace:*",
    "@narada/env": "workspace:*",
    "@narada/storage": "workspace:*",
    "better-auth": "1.6.22",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.2",
    "@types/node": "^20.19.40",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "pino-pretty": "^13.1.3",
    "prettier": "3.8.3",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^4.1.7"
  }
}
