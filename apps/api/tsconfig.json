{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "outDir": "./dist",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "baseUrl": ".",
        "paths": {
            "@narada/database": [
                "../../packages/database/src/index.ts"
            ],
            "@narada/database/*": [
                "../../packages/database/src/*"
            ],
            "@narada/types": [
                "../../packages/types/src/index.ts"
            ],
            "@narada/types/*": [
                "../../packages/types/src/*"
            ]
        }
    },
    "include": [
        "src/**/*"
    ]
}