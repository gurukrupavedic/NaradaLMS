# VedicLMS Local Development Environment Variables
# ================================================

# DATABASE CONNECTION (REQUIRED)
# Copy your DATABASE_URL from Replit Secrets/Environment Variables
DATABASE_URL=

# REPLIT AUTH (Optional - only if you want login to work)
REPL_ID=
ISSUER_URL=https://replit.com/oidc
SESSION_SECRET=
REPLIT_DOMAINS=

# NODE ENVIRONMENT (usually "development" for local work)
NODE_ENV=development
