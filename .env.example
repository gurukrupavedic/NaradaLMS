# Narada LMS - Environment Configuration Template
# Copy this file to .env and fill in the values

# Node Environment (development, production, test)
NODE_ENV=development

# Server Port
PORT=5000

# Frontend URL (for OAuth redirects and CORS)
FRONTEND_URL=http://localhost:5000

# Database Connection URL (PostgreSQL)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/naradalms

# JWT Authentication
# Generate a secure secret for production (e.g., openssl rand -base64 32)
JWT_SECRET=change-me-in-production
JWT_EXPIRY=7d

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=104857600 # 100MB in bytes

# Google OAuth (Optional - required for Google login)
# GOOGLE_CLIENT_ID=your-client-id
# GOOGLE_CLIENT_SECRET=your-client-secret

# Admin Settings
ADMIN_EMAIL=admin@example.com
