{
  "name": "@narada/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./ids": "./src/ids.ts",
    "./permissions": "./src/permissions/index.ts"
  },
  "scripts": {
    "generate": "pnpm dlx @better-auth/cli generate --config src/index.ts",
    "lint": "eslint .",
    "format": "prettier . --write --ignore-path ../../.prettierignore",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-auth": "^1.2.8",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@narada/db": "workspace:*",
    "@narada/env": "workspace:*"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "prettier": "3.8.3",
    "typescript": "^5",
    "typescript-eslint": "^8"
  }
}
