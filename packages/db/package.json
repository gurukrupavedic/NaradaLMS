{
  "name": "@narada/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate --config drizzle.config.ts && drizzle-kit generate --config drizzle.school.config.ts",
    "generate:public": "drizzle-kit generate --config drizzle.config.ts",
    "generate:school": "drizzle-kit generate --config drizzle.school.config.ts",
    "push": "drizzle-kit push",
    "studio": "drizzle-kit studio",
    "lint": "eslint .",
    "format": "prettier . --write --ignore-path ../../.prettierignore",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@narada/env": "workspace:*",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "lru-cache": "^11.5.0",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.40",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "prettier": "3.8.3",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "typescript-eslint": "^8"
  }
}
