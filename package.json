{
  "name": "narada",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "api:dev": "dotenv -e .env -- pnpm --filter @narada/api dev",
    "api:build": "dotenv -e .env -- pnpm --filter @narada/api build",
    "auth:generate": "dotenv -e .env -- pnpm --filter @narada/auth generate",
    "db:generate": "dotenv -e .env -- pnpm --filter @narada/db generate",
    "db:push": "dotenv -e .env -- pnpm --filter @narada/db push",
    "db:studio": "dotenv -e .env -- pnpm --filter @narada/db studio",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0"
  }
}
