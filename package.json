{
  "name": "narada",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "22.13.1"
  },
  "scripts": {
    "env:fetch": "pnpm --filter @narada/tools env:fetch",
    "env:encrypt": "pnpm --filter @narada/tools env:encrypt",
    "env:link": "pnpm --filter @narada/tools env:link",
    "web:dev": "pnpm --filter @narada/web dev",
    "web:build": "pnpm --filter @narada/web build",
    "web:start": "pnpm --filter @narada/web start",
    "web:lint": "pnpm --filter @narada/web lint",
    "api:dev": "pnpm --filter @narada/api dev",
    "api:build": "pnpm --filter @narada/api build",
    "api:typecheck": "pnpm --filter @narada/api typecheck",
    "auth:generate": "pnpm --filter @narada/auth generate",
    "db:generate:public": "pnpm --filter @narada/db generate:public",
    "db:generate:school": "pnpm --filter @narada/db generate:school",
    "db:push": "pnpm --filter @narada/db push",
    "db:studio": "pnpm --filter @narada/db studio",
    "schools:create": "pnpm --filter @narada/tools schools:create",
    "seed": "pnpm --filter @narada/tools seed",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test"
  }
}
